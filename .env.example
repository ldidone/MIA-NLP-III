OPENAI_API_KEY=
LLM_PROVIDER=openai
VECTORSTORE_PATH=data/vectorstore
ALLOW_REAL_PROCESS_KILL=false

# Embedding backend for semantic retrieval:
#   auto   = OpenAI if OPENAI_API_KEY is set, else local if installed, else keyword fallback
#   openai = OpenAI embeddings (needs OPENAI_API_KEY + langchain-openai)
#   local  = offline sentence-transformers embeddings (pip install -e ".[local]")
#   none   = disable embeddings and use the keyword fallback retriever
EMBEDDING_BACKEND=auto
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
